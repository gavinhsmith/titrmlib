# Doxygen reads the public header and writes XML for doxybook2, which turns it
# into the Markdown API reference in docs/. Run with `make docs`.
PROJECT_NAME           = titrmlib
INPUT                  = src/titrm.h
OUTPUT_DIRECTORY       = obj/doxygen
OPTIMIZE_OUTPUT_FOR_C  = YES
EXTRACT_ALL            = NO
GENERATE_HTML          = NO
GENERATE_LATEX         = NO
GENERATE_XML           = YES
QUIET                  = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_AS_ERROR          = FAIL_ON_WARNINGS
